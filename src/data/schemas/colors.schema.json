{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "corrupted-theme colors",
  "type": "object",
  "required": [
    "schemaVersion",
    "palette",
    "themeColors",
    "accents",
    "semanticUse"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "palette": {
      "type": "object",
      "required": [
        "white",
        "black",
        "cyan",
        "magenta",
        "purple",
        "magenta2",
        "red",
        "green"
      ],
      "additionalProperties": false,
      "properties": {
        "white": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "black": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cyan": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "magenta": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "purple": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "magenta2": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "red": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "green": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "semanticUse": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "white",
          "black",
          "cyan",
          "magenta",
          "purple",
          "magenta2",
          "red",
          "green"
        ]
      }
    },
    "tierPaletteNotes": {
      "type": "string"
    },
    "themeColors": {
      "description": "The aesthetic. A composition should read as on-theme using only these.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "white",
          "black",
          "magenta",
          "purple",
          "magenta2",
          "red",
          "cyan",
          "green"
        ]
      }
    },
    "accents": {
      "description": "Legibility and emphasis tools - highlight, or lift text off a dark background. Not state signals.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "white",
          "black",
          "magenta",
          "purple",
          "magenta2",
          "red",
          "cyan",
          "green"
        ]
      }
    }
  }
}
