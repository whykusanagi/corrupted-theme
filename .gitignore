node_modules/
package-lock.json
yarn.lock

# Build output
dist/
build/
*.min.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Environment
# .env.* is deliberately broad (repo policy §10): .env.production and friends
# would otherwise slip past a narrower `.env.local` rule. Template files are
# re-admitted explicitly — they hold placeholders, never values.
.env
.env.*
!.env.example
!**/.env.example

# Temporary
*.tmp
.cache/
celeste_widget_pack/

# NPM registry (contains tokens)
.npmrc

# Internal planning docs (store locally in ~/.claude/projects/.../memory/plans/ instead)
docs/plans/

# Local AI session data (never commit)
.claude/

# Internal docs + infra (owner rule 2026-07-05: anything with internal file
# paths, infra IDs, or non-design content stays out of GitHub; files remain
# on disk for local tooling/agents)
CLAUDE.md
CORRUPTION_BUFFER_IMPLEMENTATIONS.md
docs/IMPLEMENTATION_NOTES.md
docs/governance/
docs/planning/
docs/CAPABILITIES.md
docs/PERSONALITY.md
docs/LLM_PROVIDERS.md
docs/ROUTING.md
docs/IMPLEMENTATION_VALIDATION.md
cdn-worker/

# design-sync local state (never published — not in package.json files allowlist)
.design-sync/

# celeste-cli local state — auto-stamped with a git hash on every run, so it
# would churn on every commit. Neither is in the package.json files allowlist,
# so neither ships either way.
.celeste/
.grimoire
